      <aliases enabled='yes' />
      <column caption='PROFIT MARGIN' datatype='real' default-format='p0.00%' name='[Calculation_2345932104491008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
      <column caption='AVERAGE ORDER VALUE' datatype='real' name='[Calculation_2345932425347073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / COUNTD([order_id])' />
      </column>
      <column caption='Loss-Making Subcategories' datatype='integer' name='[Calculation_2345932426145794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF { FIXED [sub-category] : SUM([profit]) } &lt; 0&#10;    THEN [sub-category]&#10;    END&#10;)' />
      </column>
      <column caption='TOTAL QUANTITY SOLD' datatype='integer' name='[Calculation_2345932427206659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])' />
      </column>
